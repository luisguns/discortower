+export function voiceEncoding(profile) {
+    if (profile === 'standard')
+        return {};
+    const maxBitrate = profile === 'speech32' ? 32_000 : 48_000;
+    return {
+        codecOptions: {
+            opusStereo: false,
+            opusFec: true,
+            opusDtx: true,
+            opusPtime: 20,
+            opusMaxAverageBitrate: maxBitrate,
+        },
+        encodings: [{ maxBitrate, priority: 'high', networkPriority: 'high' }],
+    };
+}
+//# sourceMappingURL=voice-profile.js.map
