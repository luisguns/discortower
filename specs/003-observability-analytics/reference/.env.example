# Copie para .env e preencha com os valores da Grafana Cloud.
# Onde achar: grafana.com  →  seu stack  →  "Connections" / "Add new connection"
#   - Prometheus: botão "Send Metrics"  → mostra URL + username (um número)
#   - Loki:       "Send Logs"           → mostra URL + username (outro número)
#   - Token:      "Access Policies" → crie um token com escopos
#                 metrics:write + logs:write (serve para ambos)

# ── Prometheus (métricas) ──
GC_PROM_URL=https://prometheus-prod-XX-prod-YY.grafana.net/api/prom/push
GC_PROM_USER=1234567

# ── Loki (logs) ──
GC_LOKI_URL=https://logs-prod-XX.grafana.net/loki/api/v1/push
GC_LOKI_USER=7654321

# ── Token único p/ os dois (Access Policy token) ──
GC_TOKEN=glc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
