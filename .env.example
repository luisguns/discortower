VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# Redirect exato cadastrado no Supabase Auth para o Web. O Desktop usa fordkall://auth/callback.
VITE_SUPABASE_AUTH_REDIRECT_URL=http://localhost:5173/
# Microfone Control Tower: speech32 (padrão validado no benchmark), speech48 ou standard.
# Use standard para retornar ao perfil anterior sem trocar o provider.
VITE_CONTROL_TOWER_VOICE_PROFILE=speech32
